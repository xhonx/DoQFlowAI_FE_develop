# docker-compose.local.yml 전용. .env로 복사한 뒤 비밀값을 채운다.
# 실제 키·비밀번호는 커밋하지 않는다.
APP_MODE=development
LAB_VULNS=
LOCAL_PORT=8088
BACKEND_PORT=18080

DB_ROOT_PASSWORD=
DB_APP_USER=doqflow
DB_APP_PASSWORD=
JWT_SECRET=
SIGNUP_KEY_LEAD=
AI_INTERNAL_KEY=
# 비어 있어도 AI 서비스는 기동 가능. 색인·질의응답에는 유효한 키 필요.
OPENAI_API_KEY=

# URL 가져오기 허용 도메인. 예: raw.githubusercontent.com (와일드카드 없음)
URL_IMPORT_ALLOWED_HOSTS=
